// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  passwordHash String

  displayName String?
  bio         String?
  avatarUrl   String?

  emailVerified Boolean @default(false)
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //articles
  canComment Boolean       @default(true)
  sessions   UserSession[]
  comments   Comment[]
  likes      Like[]
}

model Content {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  category        String
  summary         String
  body            String
  imageUrl        String    @default("")
  tag             String    @default("")
  readTime        Int       @default(5)
  status          String    @default("draft")
  featured        Boolean   @default(false)
  sourceName      String    @default("")
  sourceUrl       String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  //articles
  requiresLogin   Boolean   @default(false)
  commentsEnabled Boolean   @default(true)
  comments        Comment[]
  like            Like[]

  @@index([status, category])
}

model SiteSettings {
  id                  String   @id @default("main")
  siteName            String
  tagline             String
  heroTitle           String
  heroDescription     String
  heroEyebrow         String   @default("A LITTLE KNOWLEDGE. A HEALTHIER YOU.")
  heroImageUrl        String   @default("/images/hero-care.jpg")
  heroImageCaption    String   @default("Good health starts with understanding.")
  topicsTitle         String   @default("What would you like to explore?")
  topicsDescription   String   @default("Clear answers, wherever you are on your health journey.")
  featuredTitle       String   @default("A little more understanding.")
  featuredDescription String   @default("Helpful reads for everyday health and a better-informed you.")
  indexTitle          String   @default("Find it. Understand it.")
  indexDescription    String   @default("Browse our growing health library, one letter at a time.")
  missionTitle        String   @default("Health information should be for everyone.")
  missionDescription  String   @default("We make medical knowledge easier to understand, so you can have more confident conversations about your health.")
  aboutText           String
  contactEmail        String
  footerText          String   @default("A healthier world begins with a better-informed you.")
  disclaimer          String   @default("For education only. This information does not replace medical advice, diagnosis, or treatment. Always speak with a qualified healthcare professional about your health.")
  updatedAt           DateTime @updatedAt
}

model Admin {
  id           String         @id @default(cuid())
  email        String         @unique
  displayName  String         @default("Administrator")
  passwordHash String
  createdAt    DateTime       @default(now())
  sessions     AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model LoginAttempt {
  key         String   @id
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
}

//articles
model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Invite {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  userId    String
  contentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId, createdAt])
  @@index([userId])
}

model Like {
  userId    String
  contentId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, contentId])
  @@index([contentId])
}
